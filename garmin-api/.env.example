# API Settings
# Replace with your own secure API key for production
API_KEY=your_secure_api_key_here

# Debug settings (set to false in production)
DEBUG=false

# Log level options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Path for storing Garmin authentication tokens
# For Railway deployment, use: /data/garmin-tokens
GARMIN_TOKEN_DIR=./garmin-tokens

# CORS settings can be configured in app/config.py
# Modify the CORS_ORIGINS list to include your production domains 