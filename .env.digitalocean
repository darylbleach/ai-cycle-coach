# This file is specifically for DigitalOcean deployment
# It contains placeholders for critical environment variables

# Database connection - Use placeholder for security, set actual value in DigitalOcean
DATABASE_URL=postgresql://username:password@hostname:port/database?sslmode=require

# NextAuth configuration
NEXTAUTH_URL=https://ai-cycle-coach-cxvg5.ondigitalocean.app
NEXTAUTH_SECRET=replaceThisWithASecureRandomString

# Node environment
NODE_ENV=production

# Python and Garmin settings
PYTHON_PATH=/app/venv/bin/python
GARMIN_TOKEN_DIR=/app/garmin-tokens
USE_SAMPLE_DATA=false

# Set to true to skip automatic database initialization on startup
SKIP_DB_INIT=true 