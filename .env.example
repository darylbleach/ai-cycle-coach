# Database (Postgres is required). Neon is the recommended hosted option:
# https://neon.tech — create a project, then paste the connection string here.
# Local Postgres also works: postgresql://username:password@localhost:5432/ai_coach?schema=public
DATABASE_URL="postgresql://username:password@ep-example.region.aws.neon.tech/neondb?sslmode=require"

# Authentication
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="https://your-vercel-url.vercel.app"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Garmin API
GARMIN_CONSUMER_KEY="your-garmin-consumer-key"
GARMIN_CONSUMER_SECRET="your-garmin-consumer-secret"

# Cron API Key (required in production; sent as X-Cron-API-Key)
CRON_API_KEY="your-secure-api-key"

# Python path
PYTHON_PATH="/usr/bin/python3"

# OpenAI API Key (for training plan creation)
OPENAI_API_KEY="your-openai-api-key"

# Internal API Key (for workout adjustments)
INTERNAL_API_KEY="your-internal-api-key-for-workout-adjustment" 